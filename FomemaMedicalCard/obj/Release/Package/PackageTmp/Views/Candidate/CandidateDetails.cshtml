
@{
    ViewBag.Title = "CandidateDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Fomema Medical Card</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Cleaning Company Website Template" name="keywords">
    <meta content="Cleaning Company Website Template" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;300;400&display=swap" rel="stylesheet">

    <!-- CSS Libraries -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="~/Content/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/Content/lightbox/css/lightbox.min.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;300;400&display=swap" rel="stylesheet">
    @*<link href="~/Content/jquery-ui.min.css" rel="stylesheet" />*@
    <link href="~/Content/jsGrid/jsgrid.min.css" rel="stylesheet" />
    <link href="~/Content/jsGrid/jsgrid-theme.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="/resources/demos/style.css">

    <style>
        #main-div {
            height: 94vh; /* vh stands for view-port height, 1vh is 1% of screen height */
        }

        .ui-jqgrid .ui-jqgrid-bdiv {
            position: relative;
            margin: 0em;
            padding: 0;
            /*overflow: auto;*/
            overflow-x: hidden;
            overflow-y: auto;
            text-align: left;
        }

        .ui-widget *, .ui-widget input, .ui-widget select, .ui-widget button {
            font-family: 'Helvetica Neue Light', 'Open Sans', Helvetica;
            font-size: 14px;
            font-weight: 300 !important;
        }

        .details-form-field input,
        .details-form-field select {
            width: 250px;
            float: right;
        }

        .details-form-field {
            margin: 30px 0;
        }

            .details-form-field:first-child {
                margin-top: 10px;
            }

            .details-form-field:last-child {
                margin-bottom: 10px;
            }

            .details-form-field button {
                display: block;
                width: 100px;
                margin: 0 auto;
            }

        input.error, select.error {
            border: 1px solid #ff9999;
            background: #ffeeee;
        }

        label.error {
            float: right;
            margin-left: 100px;
            font-size: .8em;
            color: #ff6666;
        }
    </style>

</head>
<body>

    <div id="candidateGrid"></div>

    <div id="detailsDialog">
        <form id="detailsForm">
            <div class="details-form-field">
                <label for="name">Name:</label>
                <input id="name" name="name" type="text" />
            </div>
            <div class="details-form-field">
                <label for="age">Age:</label>
                <input id="age" name="age" type="number" />
            </div>
            <div class="details-form-field">
                <label for="newpassportno">New Passport No.:</label>
                <input id="newpassportno" name="newpassportno" type="text" />
            </div>
            <div class="details-form-field">
                <label for="oldpassportno">Old Passport No.:</label>
                <input id="oldpassportno" name="oldpassportno" type="text" />
            </div>
            <div class="details-form-field">
                <label for="countryname">Country Name:</label>
                <input id="countryname" name="countryname" type="text" />
            </div>
            <div class="details-form-field">
                <label for="covid19testdate1">Covid19 TestDate 1:</label>
                <input id="covid19testdate1" name="covid19testdate1" type="datetime" />
            </div>
            <div class="details-form-field">
                <label for="covid19testdate2">Covid19 TestDate 2:</label>
                <input id="covid19testdate2" name="covid19testdate2" type="text" />
            </div>
            <div class="details-form-field">
                <label for="covid19testdate3">Covid19 TestDate 3:</label>
                <input id="covid19testdate3" name="covid19testdate3" type="text" />
            </div>
            <div class="details-form-field">
                <label for="covid19testdate4">Covid19 TestDate 4:</label>
                <input id="covid19testdate4" name="covid19testdate4" type="text" />
            </div>
            <div class="details-form-field">
                <label for="clinicname">Clinic Name:</label>
                <input id="clinicname" name="clinicname" type="text" />
            </div>
            <div class="details-form-field">
                <label for="cliniclocation">Clinic Location:</label>
                <input id="cliniclocation" name="cliniclocation" type="text" />
            </div>
            <div class="details-form-field">
                <label for="vaccinedose1date">Vaccine DoseDate 1:</label>
                <input id="vaccinedose1date" name="vaccinedose1date" type="text" />
            </div>
            <div class="details-form-field">
                <label for="vaccinedose2date">Vaccine DoseDate 2:</label>
                <input id="vaccinedose2date" name="vaccinedose2date" type="text" />
            </div>
            <div class="details-form-field">
                <button type="submit" id="save">Save</button>
            </div>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-1.12.4.js"></script>

    <script src="~/Scripts/jquery.validate.js"></script>
    @*<script src="~/Scripts/jquery-3.4.1.js"></script>*@
    <script src="~/Scripts/jsGrid/jsgrid.min.js"></script>
    <script src="~/Scripts/jsGrid/db.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.load-indicator.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.load-strategies.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.field.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.field.text.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.field.number.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.field.select.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.field.checkbox.js"></script>
    <script src="~/Scripts/jsGrid/jsgrid.field.control.js"></script>

    <script src="~/Scripts/bootstrap.min.js"></script>
    @*<script src="~/Scripts/jquery-ui.js"></script>*@
    @*<script src="~/Scripts/jquery-1.12.1.min.js"></script>*@



    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="~/Scripts/Candidate/Candidate.js"></script>

    <footer>
        <div id="welcome-div" class="container my-4 custom-hide">
            <div class="alert alert-success" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <strong>Success!</strong> Welcome to Secure Biometrics !
            </div>
        </div>
    </footer>

</body>
</html>

