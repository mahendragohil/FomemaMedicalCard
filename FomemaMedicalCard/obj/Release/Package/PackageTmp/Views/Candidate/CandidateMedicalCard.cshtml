@model FomemaMedicalCard.Models.CandidateModel
@{
    ViewBag.Title = "CandidateMedicalCard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Fomema Medical Card</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Cleaning Company Website Template" name="keywords">
    <meta content="Cleaning Company Website Template" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;300;400&display=swap" rel="stylesheet">

    <!-- CSS Libraries -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="~/Content/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/Content/lightbox/css/lightbox.min.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/CandidateMedicalCard.css" rel="stylesheet" />   ,,. 

    <style>
        #main-div {
            height: 100%; /* vh stands for view-port height, 1vh is 1% of screen height */
        }
    </style>

</head>

<body>
    <div class="id-card-tag"></div>
    <div class="id-card-tag-strip"></div>
    <div class="id-card-hook"></div>
    <div class="id-card-holder">
        <div class="id-card main-div">
            <div>
                <h2>Fomema Medical Card</h2>
            </div>
            <div class="photo">
                <img src= '@Model.PictureURL' style="border-radius: 50%; width: 100px; height:80px;" />
            </div>
            @if (Model != null)
            {
                <h2 style="margin-bottom:15px;"><span id="span_name">@Model.Name</span></h2>
                <p><span><b>Candidate Age: </b></span><span id="span_age">@Model.Age</span></p>
                <p><span><b>New Passport No: </b></span><span id="span_newPassportNo">@Model.NewPassportNo</span></p>
                <p><span><b>Old Passport No: </b></span><span id="span_oldPassportNo">@Model.OldPassportNo</span></p>
                <p><span><b>Country Name: </b></span><span id="span_CountryName">@Model.CountryName</span></p>
                <p><span><b>1<sup>st </sup>Date of Covid-19 Test: </b></span><span id="span_Covid19_1">@Model.Covid19TestDate1</span></p>
                <p><span><b>2<sup>nd </sup>Date of Covid-19 Test: </b></span><span id="span_Covid19_2">@Model.Covid19TestDate2</span></p>
                <p><span><b>3<sup>rd </sup>Date of Covid-19 Test: </b></span><span id="span_Covid19_3">@Model.Covid19TestDate3</span></p>
                <p><span><b>4<sup>th </sup>Date of Covid-19 Test: </b></span><span id="span_Covid19_4">@Model.Covid19TestDate4</span></p>
                <p><span><b>Clinic Name: </b></span><span id="span_clinic_name">@Model.ClinicName</span></p>
                <p><span><b>Clinic Location: </b></span><span id="span_clinic_location">@Model.ClinicLocation</span></p>
                <p><span><b>1<sup>st </sup>Vaccine Dose Date: </b></span><span id="span_Vaccine_1">@Model.VaccineDose1Date</span></p>
                <p><span><b>2<sup>nd </sup>Vaccine Dose Date: </b></span><span id="span_Vaccine_1">@Model.VaccineDose2Date</span></p>                
            }
        </div>
    </div>
</body>
</html>



