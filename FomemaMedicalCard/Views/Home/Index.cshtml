@{
    ViewBag.Title = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Fomema Medical Card</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Cleaning Company Website Template" name="keywords">
    <meta content="Cleaning Company Website Template" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;300;400&display=swap" rel="stylesheet">

    <!-- CSS Libraries -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="~/Content/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/Content/lightbox/css/lightbox.min.css" rel="stylesheet" />
    <link href="~/Content/style.css" rel="stylesheet" />


    <style>
        #main-div {
            height: 100vh; /* vh stands for view-port height, 1vh is 1% of screen height */
            width: 100vw; /* vw stands for view-port width, 1vh is 1% of screen width */
        }

        .modal-content, .modal-body {
            background-color: #3057A6;
        }
    </style>

</head>

<body>
    <div id="div-login" class="hero row align-items-center">
        <div class="col-md-7">
            <h2>Welcome to</h2>
            <h2>Foreign Workers’ Medical Examination</h2>
            <h2><span>Medical card system</span></h2>
        </div>
        <div class="col-md-5">
            <div class="form">
                <h3>Sign In</h3>
                <form>
                    <div class="form-group">
                        <input id="text-userId" class="form-control" type="text" placeholder="Email or IC's Number">
                    </div>
                    <div class="form-group">
                        <input id="text-password" class="form-control" type="password" placeholder="Password">
                    </div>
                    <div class="form-group">
                        <button id="btn-login" type="button" class="btn btn-block">Login</button>
                    </div>
                    <div class="form-group">
                        <a class="form-link text-light font-weight-bold" href="#" data-toggle="modal" data-target="#myModal">Clinic Registration</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="login-failed-div" class="container my-4 custom-hide">
        <div class="alert alert-danger" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <strong>Error!</strong> Login Failed !
        </div>
    </div>

    <!-- The Modal -->
    <div class="modal fade" id="myModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title text-light font-weight-bold">Clinic Registration</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="div-submit" class="hero row justify-content-md-center">
                        <div class="col-md-9">
                            <div class="form">
                                <form>
                                    <div class="form-group">
                                        <input id="text-clinicname" class="form-control" type="text" placeholder="Clinic Name">
                                    </div>
                                    <div class="form-group">
                                        <input id="text-doctorsname" class="form-control" type="text" placeholder="Doctor's Name">
                                    </div>
                                    <div class="form-group">
                                        <input id="text-doctorsicnumber" class="form-control" type="text" placeholder="IC Number">
                                    </div>
                                    <div class="form-group">
                                        <input id="text-clinicpassword" class="form-control" type="password" placeholder="Password">
                                    </div>
                                    <div class="form-group">
                                        <input id="text-clinicconfirmpassword" class="form-control" type="password" placeholder="Confirm Password">
                                    </div>
                                    <div class="form-group">
                                        <button id="btn-submit" type="button" class="btn btn-block">REGISTER</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div id="submit-failed-div" class="container my-4 custom-hide">
                        <div class="alert alert-danger" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <strong>Error!</strong> Submit Failed !
                        </div>
                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>

    <script src="~/Content/easing/easing.min.js"></script>
    <script src="~/Content/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/Content/isotope/isotope.pkgd.min.js"></script>
    <script src="~/Content/lightbox/js/lightbox.min.js"></script>

    <script src="~/Scripts/main.js"></script>
    <script src="~/Scripts/Login/Index.js"></script>

</body>
</html>


